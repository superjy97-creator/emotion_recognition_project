# ==========================================
# Emotion Recognition Project .gitignore
# ==========================================


# 가상환경
.venv/
venv/


# ==========================================
# 대용량 데이터
# AI-Hub 원본 및 전처리 데이터는 GitHub 미포함
# ==========================================
02_data/


# ==========================================
# 모델 가중치
# 최종 실험 모델만 추적
# ==========================================
05_models/*

# 흑백 2차 최종 모델
!05_models/*pretrained_v2_dual_best*.pt

# 이전 컬러 PNG 중간 실험 모델 제외
05_models/*color_png*

# 컬러 JPG / SSD / GPU 최종 모델
!05_models/*pretrained_GPU강제사용_수업수준안정화버전9_B128*.pt


# ==========================================
# 압축 파일
# ==========================================
*.zip
*.7z
*.rar


# ==========================================
# Python 캐시
# ==========================================
__pycache__/
*.pyc
*.pyo


# ==========================================
# Jupyter 임시파일
# ==========================================
.ipynb_checkpoints/


# ==========================================
# VS Code
# ==========================================
.vscode/


# ==========================================
# OS 파일
# ==========================================
.DS_Store
Thumbs.db


# ==========================================
# 03_notebooks
# 최종 제출용 Notebook만 추적
# ==========================================
03_notebooks/*.ipynb

# 데이터 확인 / EDA / 전처리
!03_notebooks/01_sample_data_check.ipynb
!03_notebooks/02_full_data_eda.ipynb
!03_notebooks/03_preprocessing.ipynb

# 흑백 2차 최종 학습 Notebook
!03_notebooks/04_pytorch_model_training_pretrained_v2_dual_best(집에서 한 것).ipynb

# 컬러 JPG / SSD / GPU 최종 학습 Notebook
!03_notebooks/04_pytorch_model_training_pretrained_v2_dual_best_color_JPG_SSD_GPU강제사용_수업수준안정화버전9_B128.ipynb


# ==========================================
# 06_outputs
# 최종 실험 결과만 추적
# ==========================================
06_outputs/*

# 흑백 2차 최종 결과
!06_outputs/*pretrained_v2_dual_best*

# 이전 컬러 PNG 중간 실험 결과 제외
06_outputs/*color_png*

# 컬러 JPG / SSD / GPU 최종 결과
# MobileNetV3-Small / EfficientNet-B0 / ResNet18
# 및 3개 모델 비교 결과 포함
!06_outputs/*pretrained_GPU강제사용_수업수준안정화버전9_B128*